void W25Q64_CS_LOW()  { HAL_GPIO_WritePin(CS_GPIO_Port, CS_Pin, GPIO_PIN_RESET); }
void W25Q64_CS_HIGH() { HAL_GPIO_WritePin(CS_GPIO_Port, CS_Pin, GPIO_PIN_SET); }

void W25Q64_WriteEnable() {
    uint8_t cmd = 0x06;
    W25Q64_CS_LOW();
    HAL_SPI_Transmit(&hspi3, &cmd, 1, HAL_MAX_DELAY);
    W25Q64_CS_HIGH();
}

void W25Q64_WaitBusy() {
    uint8_t cmd = 0x05;
    uint8_t status;
    do {
        W25Q64_CS_LOW();
        HAL_SPI_Transmit(&hspi3, &cmd, 1, HAL_MAX_DELAY);
        HAL_SPI_Receive(&hspi3, &status, 1, HAL_MAX_DELAY);
        W25Q64_CS_HIGH();
        HAL_Delay(1); // Short delay
    } while (status & 0x01); // Check BUSY bit
}

void W25Q64_PageProgram(uint32_t addr, uint8_t *data, uint16_t len) {
    uint8_t cmd[4];
    cmd[0] = 0x02;                        // Page program command
    cmd[1] = (addr >> 16) & 0xFF;
    cmd[2] = (addr >> 8) & 0xFF;
    cmd[3] = addr & 0xFF;

    W25Q64_WriteEnable();
    W25Q64_CS_LOW();
    HAL_SPI_Transmit(&hspi3, cmd, 4, HAL_MAX_DELAY);
    HAL_SPI_Transmit(&hspi3, data, len, HAL_MAX_DELAY);
    W25Q64_CS_HIGH();
    W25Q64_WaitBusy();
}

